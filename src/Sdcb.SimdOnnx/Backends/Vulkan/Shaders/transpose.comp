#version 450
#extension GL_GOOGLE_include_directive : require
#include "et.glsl"
// Generic rank<=6 permute: dst flat idx -> src idx via permuted in-strides.
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer X { ET x[]; };
layout(set = 0, binding = 1) writeonly buffer O { ET o[]; };

layout(push_constant) uniform PC {
    uint n;
    uint os[5];                  // out strides of dims 0..4 (dim 5 stride = 1)
    uint ps[6];                  // in strides in out-dim order: inStr[perm[k]]
} p;

void main()
{
    uint i = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * 256u;
    if (i >= p.n) return;
    uint r = i, src = 0u;
    for (int k = 0; k < 5; k++)
    {
        uint dk = r / p.os[k];
        r -= dk * p.os[k];
        src += dk * p.ps[k];
    }
    o[i] = x[src + r * p.ps[5]];
}
