#version 450
#extension GL_GOOGLE_include_directive : require
#include "et.glsl"
// o = clamp(x, lo, hi) (Clip with constant bounds)
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer X { ET x[]; };
layout(set = 0, binding = 1) writeonly buffer O { ET o[]; };

layout(push_constant) uniform PC { uint n; float lo, hi; } p;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;
    o[i] = ET(clamp(float(x[i]), p.lo, p.hi));
}
