#version 450
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
// Direct-load tensor-core GEMM on 16-lane subgroups, 8x16x16 fp16 fragments (Intel Xe2 XMX),
// after SimdPaddleOCR's conv1x1_cm: A and B fragments come straight from global memory (no
// shared staging), the epilogue goes through a per-subgroup fp32 stage under full barriers.
// The shared-staged conv_cm SG16 build intermittently loses the device on the Arc B580; this
// form is the one the old OCR engine ran without losses.
//   O[m, n] = act(A[m, :] . W[n, :] + bias[n] + R[m, n])
// A fp16 [M][K] rows (1x1 conv input / im2col matrix / Gemm A), W fp16 [Npad][K] (rows padded
// to 128), K % 16 == 0. A rows past M up to the tile end are read (the binding covers them;
// their outputs are masked). Tile: (SGY * TSM * 8) x (SGX * TSN * 16), NTHR = SGX*SGY*16.
// flags: bit0 bias, bit1 residual, bits4-6 act (1 relu, 2 gelu, 3 hardswish, 4 swish)
#ifndef TSM
#define TSM 4u
#endif
#ifndef TSN
#define TSN 2u
#endif
#ifndef SGX
#define SGX 4u
#endif
#ifndef SGY
#define SGY 4u
#endif
#ifndef NTHR
#define NTHR 256
#endif

layout(local_size_x = NTHR) in;

const uint STRM = TSM * 8u;
const uint STRN = TSN * 16u;

layout(set = 0, binding = 0) readonly buffer X { f16vec4 x[]; };
layout(set = 0, binding = 1) readonly buffer W { f16vec4 w[]; };
layout(set = 0, binding = 2) readonly buffer Bias { float bias[]; };
layout(set = 0, binding = 3) readonly buffer Res { float16_t res[]; };
layout(set = 0, binding = 4) writeonly buffer O { float16_t o[]; };

layout(push_constant) uniform PC { uint mDim; uint nDim; uint kDim; uint flags; } p;

shared float stage[NTHR / 16 * 8 * 16];

float ferf(float v)
{
    float s = v < 0.0 ? -1.0 : 1.0;
    float ax = abs(v);
    float t = 1.0 / (1.0 + 0.3275911 * ax);
    float poly = ((((1.061405429 * t - 1.453152027) * t + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t;
    return (1.0 - poly * exp(-ax * ax)) * s;
}

float actf(float v, uint act)
{
    if (act == 1u) return max(v, 0.0);
    if (act == 2u) return 0.5 * v * (1.0 + ferf(v * 0.7071067811865475));
    if (act == 3u) return v * clamp(v * (1.0 / 6.0) + 0.5, 0.0, 1.0);
    if (act == 4u) return v / (1.0 + exp(-v));
    return v;
}

void main()
{
    uint sg = gl_SubgroupID;
    uint lane = gl_SubgroupInvocationID;
    uint sgx = sg % SGX, sgy = sg / SGX;
    uint m0 = gl_WorkGroupID.x * (SGY * STRM);
    uint n0 = gl_WorkGroupID.y * (SGX * STRN);

    uint act = (p.flags >> 4) & 7u;
    bool hasBias = (p.flags & 1u) != 0u;
    bool hasRes = (p.flags & 2u) != 0u;

    coopmat<float, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator> acc[TSM][TSN];
    for (uint i = 0u; i < TSM; i++)
        for (uint j = 0u; j < TSN; j++)
            acc[i][j] = coopmat<float, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator>(0.0f);

    uint kv = p.kDim >> 2;             // K in vec4 units
    uint xa = (m0 + sgy * STRM) * kv;  // A strip base (vec4 elems)
    uint wb = (n0 + sgx * STRN) * kv;  // B strip base

    coopmat<float16_t, gl_ScopeSubgroup, 8, 16, gl_MatrixUseA> ma[TSM];
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> mb[TSN];
    for (uint kb = 0u; kb < kv; kb += 4u) {
        for (uint i = 0u; i < TSM; i++)
            coopMatLoad(ma[i], x, xa + i * 8u * kv + kb, kv, gl_CooperativeMatrixLayoutRowMajor);
        for (uint j = 0u; j < TSN; j++)
            coopMatLoad(mb[j], w, wb + j * 16u * kv + kb, kv, gl_CooperativeMatrixLayoutColumnMajor);
        for (uint i = 0u; i < TSM; i++)
            for (uint j = 0u; j < TSN; j++)
                acc[i][j] = coopMatMulAdd(ma[i], mb[j], acc[i][j]);
    }

    for (uint i = 0u; i < TSM; i++) {
        for (uint j = 0u; j < TSN; j++) {
            coopMatStore(acc[i][j], stage, sg * 128u, 8u, gl_CooperativeMatrixLayoutColumnMajor);
            barrier();
            uint rm = sgy * STRM + i * 8u;
            uint cn = sgx * STRN + j * 16u;
            for (uint l = 0u; l < 8u; l++) {
                uint e = lane * 8u + l;
                uint mm = e >> 4, nn = e & 15u;
                uint gmr = m0 + rm + mm;
                uint gnc = n0 + cn + nn;
                if (gmr < p.mDim && gnc < p.nDim) {
                    float v = stage[sg * 128u + nn * 8u + mm];
                    if (hasBias) v += bias[gnc];
                    uint oe = gmr * p.nDim + gnc;
                    if (hasRes) v += float(res[oe]);
                    o[oe] = float16_t(actf(v, act));
                }
            }
            barrier();
        }
    }
}
