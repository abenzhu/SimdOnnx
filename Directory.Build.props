<Project>
  <!-- Package version: edit here and keep build/00-common.linq in sync. -->
  <PropertyGroup>
    <SdcbSimdOnnxVersion Condition="'$(SdcbSimdOnnxVersion)' == ''">0.1.0</SdcbSimdOnnxVersion>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
    <Authors>sdcb</Authors>
    <Company>Sdcb</Company>
    <PackageProjectUrl>https://github.com/sdcb/SimdOnnx</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sdcb/SimdOnnx.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Sdcb.SimdOnnx'">
    <Version>$(SdcbSimdOnnxVersion)</Version>
    <IsPackable>true</IsPackable>
    <Description>Pure C# inference engine for a subset of ONNX: graph compiler (fusion, layout planning, static memory arena), hand-written CPU SIMD kernels (AVX-512 / AVX2 / NEON / WASM SIMD / Vector) and GPU backends over Vulkan and Metal (net10.0). No ONNX Runtime or native binaries. Unrelated to Microsoft ONNX Runtime.</Description>
    <PackageTags>Sdcb;ONNX;inference;SIMD;AVX2;AVX-512;NEON;Vulkan;Metal;neural-network</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)assets\icon.png" Pack="true" PackagePath="icon.png" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="README.md" Visible="false" />
  </ItemGroup>
</Project>
